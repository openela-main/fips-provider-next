 }
 
 const OSSL_DISPATCH ossl_ml_kem_asym_kem_functions[] = {
diff --git a/providers/implementations/keymgmt/ml_kem_kmgmt.c b/providers/implementations/keymgmt/ml_kem_kmgmt.c
