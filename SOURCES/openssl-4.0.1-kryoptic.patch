@@ -825,13 +830,15 @@ static void *ml_kem_gen(void *vgctx, OSSL_CALLBACK *osslcb, void *cbarg)
         if (!ml_kem_pairwise_test(key, ML_KEM_KEY_FIXED_PCT)) {
