@@ -150,6 +150,8 @@ static int rsa_init(void *vprsactx, void *vrsa, const OSSL_PARAM params[],
             OSSL_FIPS_IND_SETTABLE0, prsactx->libctx,
             prsactx->rsa, desc, protect))
