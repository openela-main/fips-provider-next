From 9b6da3ca2f40b5e656337772e329565d9aa77665 Mon Sep 17 00:00:00 2001
From: Simo Sorce <simo@redhat.com>
Date: Thu, 23 Jul 2026 12:09:51 -0400
Subject: [PATCH 36/36] Default to defer tests if defer_tests is NULL

Update the FIPS self-test logic to default to deferring tests when the
defer_tests parameter is NULL.

This changes the fips provider behavior with old openssl versions but
allows us to skip costly tests when not needed, and is a reasonable
default to have.

Assisted-by: Gemini:Gemini Pro Latest
Signed-off-by: Simo Sorce <simo@redhat.com>
---
 providers/fips/self_test.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/providers/fips/self_test.c b/providers/fips/self_test.c
index 7f1e6bf1e7..cc864b9841 100644
--- a/providers/fips/self_test.c
+++ b/providers/fips/self_test.c
@@ -493,8 +493,11 @@ int SELF_TEST_post(SELF_TEST_POST_PARAMS *st, void *fips_global,
             }
         }
 
-        if ((st->defer_tests != NULL)
-            && strcmp(st->defer_tests, "1") == 0) {
+        /* we default to defer tests as older openssl versions do
+         * not know about the defer_tests parameter */
+        if (st->defer_tests == NULL
+            || (st->defer_tests != NULL
+                && strcmp(st->defer_tests, "1") == 0)) {
             /* Mark all non executed tests as deferred */
             for (int i = 0; i < ST_ID_MAX; i++) {
                 if (st_all_tests[i].state == SELF_TEST_STATE_INIT) {
-- 
